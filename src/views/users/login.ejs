<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="login-container">
  <h2 class="form-title">Iniciar sesión</h2>

  <% if (typeof error !== 'undefined') { %>
    <p class="error"><%= error %></p>
  <% } %>

  <% if (typeof errors !== 'undefined' && errors.length) { %>
    <ul class="error-list">
      <% errors.forEach(e => { %>
        <li class="error"><%= e.msg %></li>
      <% }) %>
    </ul>
  <% } %>

  <form action="/users/login" method="POST" class="form-login">
    <div class="form-group">
      <label for="email">Correo electrónico</label>
      <input type="email" id="email" name="email" value="<%= (old && old.email) ? old.email : '' %>" required>
    </div>

    <div class="form-group">
      <label for="password">Contraseña</label>
      <input type="password" id="password" name="password" required>
    </div>

    <div class="form-group checkbox-group">
      <label>
        <input type="checkbox" name="remember">
        Recordarme
      </label>
    </div>

    <button type="submit" class="btn">Ingresar</button>

    <p class="text-small">
      ¿No tenés cuenta? <a href="/users/register">Registrate</a>
    </p>
  </form>
</main>

<%- include('../partials/footer') %>
