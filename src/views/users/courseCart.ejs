<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="carrito">
  <h2>Mi Carrito</h2>

  <section class="carrito-items">
    <div class="item">
      <img src="/imgs/bienestarEmocional.png" alt="Curso 1">
      <div class="info">
        <h3>Curso de Bienestar Emocional</h3>
        <p>Docente: Dra. Juana Perez</p>
        <p>Precio: $12000</p>
        <label>
          Cantidad:
          <input type="number" value="1" min="1">
        </label>
        <button class="btn">Eliminar</button>
      </div>
    </div>

    <div class="item">
      <img src="/imgs/mindfulness.png" alt="Curso 2">
      <div class="info">
        <h3>Curso de Mindfulness</h3>
        <p>Docente: Dr. Juan Pérez</p>
        <p>Precio: $10000</p>
        <label>
          Cantidad:
          <input type="number" value="1" min="1">
        </label>
        <button class="btn">Eliminar</button>
      </div>
    </div>
  </section>

  <div class="resumen">
    <h3>Total: $22000</h3>
    <button class="btn">Finalizar Compra</button>
  </div>
</main>

<%- include('../partials/footer') %>
