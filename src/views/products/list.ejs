<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main>
  <section class="cursos-destacados">
    <h2>Listado de Cursos</h2>
    <div class="cursos">
      <% courses.forEach(course => { %>
        <% const imageSrc = course.image && course.image.startsWith('/') ? course.image : `/imgs/${course.image || 'hero.png'}`; %>
        <div class="curso">
          <img src="<%= imageSrc %>" alt="<%= course.name %>">
          <h3><%= course.name %></h3>
          <p><%= course.description %></p>
          <a href="/courses/<%= course.id %>" class="btn-vermas">Ver más</a>
        </div>
      <% }) %>
    </div>
  </section>
</main>

<%- include('../partials/footer') %>
