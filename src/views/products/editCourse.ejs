<%- include('../partials/head') %>
<%- include('../partials/header') %>

<main class="registro-main">
  <% if (typeof errors !== 'undefined' && errors.length) { %>
    <ul class="error-list">
      <% errors.forEach(e => { %>
        <li class="error"><%= e.msg %></li>
      <% }) %>
    </ul>
  <% } %>

  <form class="formulario-registro" action="/courses/<%= course.id %>?_method=PUT" method="POST">
    <h2>Editar Curso</h2>

    <label for="name">Nombre del curso</label>
    <input type="text" id="name" name="name" value="<%= course.name %>" required>

    <label for="description">Descripción</label>
    <input type="text" id="description" name="description" value="<%= course.description %>" required>

    <label for="image">Imagen (URL)</label>
    <input type="text" id="image" name="image" value="<%= course.image %>">

    <label for="category">Categoría</label>
    <input type="text" id="category" name="category" value="<%= course.category %>" required>

    <label for="colors">Colores (separados por coma)</label>
    <input type="text" id="colors" name="colors" value="<%= (course.colors || []).join(', ') %>" />

    <label for="price">Precio</label>
    <input type="number" id="price" name="price" min="0" step="1" value="<%= course.price %>" required>

    <label for="stock">Stock</label>
    <input type="number" id="stock" name="stock" min="0" step="1" value="<%= course.stock || 0 %>">

    <button type="submit">Guardar Cambios</button>
  </form>
</main>

<%- include('../partials/footer') %>
